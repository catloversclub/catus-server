generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String   @id @default(uuid(7))
  //TODO: Use UserIdentity instead
  kakaoId          String?  @unique @map("kakao_id")
  nickname         String   @unique
  isLivingWithCat  Boolean  @default(false) @map("is_living_with_cat")
  hasAgreedToTerms Boolean  @default(false) @map("has_agreed_to_term")
  phone            String?
  profileImageUrl  String?  @map("profile_image_url")
  followerCount    Int      @default(0) @map("follower_count")
  followingCount   Int      @default(0) @map("following_count")
  createdAt        DateTime @default(now()) @map("created_at")

  following Follow[] @relation("Follows")
  followers Follow[] @relation("FollowedBy")

  cats                  Cat[]
  favoriteAppearances   Appearance[]
  favoritePersonalities Personality[]
  posts                 Post[]
  comments              Comment[]
  postLikes             PostLike[]
  postBookmarks         PostBookmark[]
  commentLikes          CommentLike[]
  UserIdentity          UserIdentity[]
  refreshTokens         RefreshToken[]
  Report                Report[]
  PushToken             PushToken[]
  notifications         Notification[]
  notificationSetting   NotificationSetting?
  blocking              UserBlock[]          @relation("UserBlocks")
  blockedBy             UserBlock[]          @relation("UserBlockedBy")

  @@map("user")
}

model RefreshToken {
  id        String    @id @default(uuid(7))
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_token")
}

model Follow {
  id          Int      @id @default(autoincrement())
  followerId  String   @map("follower_id")
  followingId String   @map("following_id")
  createdAt   DateTime @default(now()) @map("created_at")

  follower     User        @relation("Follows", fields: [followerId], references: [id], onDelete: Cascade)
  following    User        @relation("FollowedBy", fields: [followingId], references: [id], onDelete: Cascade)
  followedCats FollowCat[]

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
  @@map("follow")
}

model FollowCat {
  followId  Int      @map("follow_id")
  catId     String   @map("cat_id")
  createdAt DateTime @default(now()) @map("created_at")

  follow Follow @relation(fields: [followId], references: [id], onDelete: Cascade)
  cat    Cat    @relation(fields: [catId], references: [id], onDelete: Cascade)

  @@id([followId, catId])
  @@index([catId])
  @@map("follow_cat")
}

model UserBlock {
  id        Int      @id @default(autoincrement())
  blockerId String   @map("blocker_id")
  blockedId String   @map("blocked_id")
  createdAt DateTime @default(now()) @map("created_at")

  blocker User @relation("UserBlocks", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("UserBlockedBy", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId, id])
  @@index([blockedId, blockerId])
  @@map("user_block")
}

enum Provider {
  APPLE
  GOOGLE
  KAKAO
}

model UserIdentity {
  id        String
  provider  Provider
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, id])
  @@map("user_identity")
}

enum Gender {
  MALE
  FEMALE
  UNKNOWN
}

model Cat {
  id              String    @id @default(uuid(7))
  name            String
  gender          Gender    @default(UNKNOWN)
  profileImageUrl String?   @map("profile_image_url")
  birthDate       DateTime? @map("birth_date") @db.Date
  breed           String?
  type            Int?
  createdAt       DateTime  @default(now()) @map("created_at")

  butler        User          @relation(fields: [butlerId], references: [id], onDelete: Cascade)
  butlerId      String
  appearances   Appearance[]
  personalities Personality[]
  posts         Post[]
  followedBy    FollowCat[]

  @@index([butlerId, id])
  @@map("cat")
}

model Appearance {
  id    Int    @id @default(autoincrement())
  label String @unique()

  users User[]
  cats  Cat[]

  @@map("appearance")
}

model Personality {
  id    Int    @id @default(autoincrement())
  label String @unique()

  users User[]
  cats  Cat[]

  @@map("personality")
}

model Post {
  id        String   @id @default(uuid(7))
  likeCount Int      @default(0) @map("like_count")
  content   String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  authorId String  @map("author_id")
  author   User    @relation(fields: [authorId], references: [id], onDelete: Cascade)
  catId    String? @map("cat_id")
  cat      Cat?    @relation(fields: [catId], references: [id], onDelete: SetNull)

  images    PostImage[]
  comments  Comment[]
  likes     PostLike[]
  bookmarks PostBookmark[]
  Report    Report[]

  @@index([authorId, id])
  @@index([catId, id])
  @@map("post")
}

model PostImage {
  id    String @id @default(uuid(7))
  url   String
  order Int

  postId String @map("post_id")
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, order])
  @@map("post_image")
}

model Comment {
  id        String   @id @default(uuid(7))
  likeCount Int      @default(0) @map("like_count")
  content   String
  createdAt DateTime @default(now())

  postId   String @map("post_id")
  post     Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId String @map("author_id")
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  parentId     String?       @map("parent_id")
  parent       Comment?      @relation("CommentToComment", fields: [parentId], references: [id], onDelete: Cascade)
  replies      Comment[]     @relation("CommentToComment")
  commentLikes CommentLike[]

  @@index([postId, id])
  @@index([parentId, id])
  @@map("comment")
}

model PostLike {
  postId    String   @map("post_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([createdAt, postId])
  @@map("post_like")
}

model PostBookmark {
  postId    String   @map("post_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([userId, postId])
  @@map("post_bookmark")
}

model CommentLike {
  commentId String   @map("comment_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([commentId, userId])
  @@map("comment_like")
}

model Report {
  postId     String @map("post_id")
  reporterId String @map("reporter_id")

  post     Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  reporter User @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@id([postId, reporterId])
  @@map("report")
}

model PushToken {
  token      String       @id
  userId     String       @map("user_id")
  platform   PushPlatform
  enabled    Boolean      @default(true)
  lastUsedAt DateTime?    @map("last_used_at")
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_token")
}

model Notification {
  id        String    @id @default(uuid(7))
  userId    String    @map("user_id")
  title     String?
  body      String?
  data      Json?
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, id])
  @@index([userId, readAt])
  @@map("notification")
}

model NotificationSetting {
  userId           String   @id @map("user_id")
  allEnabled       Boolean  @default(true) @map("all_enabled")
  postLikeEnabled  Boolean  @default(true) @map("post_like_enabled")
  commentEnabled   Boolean  @default(true) @map("comment_enabled")
  replyEnabled     Boolean  @default(true) @map("reply_enabled")
  followEnabled    Boolean  @default(true) @map("follow_enabled")
  marketingEnabled Boolean  @default(true) @map("marketing_enabled")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_setting")
}

enum PushPlatform {
  ios
  android
}
